{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShiftBoss",
  "version": "0.1.0",
  "identifier": "dev.shiftboss.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ShiftBoss",
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#050505"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A control room for your Claude Code sessions",
    "longDescription": "ShiftBoss shows every Claude Code session running in herdr, the tasks they are on, the decisions waiting for you and the promises you made, live, from one window.",
    "externalBin": ["binaries/shiftboss-server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
